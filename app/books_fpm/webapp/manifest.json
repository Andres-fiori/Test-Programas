{
  "_version": "1.76.0",
  "sap.app": {
    "id": "booksfpm",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.19.3",
      "toolsId": "3269e13d-bedd-4288-a7c0-3ecd124fb1e5"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/books-srv/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.139.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "booksfpm.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "name": "BooksSetMain",
          "pattern": ":?query:",
          "target": "BooksSetMain"
        },
        {
          "name": "BooksSetDetailsPage",
          "pattern": "BooksSet({BooksSetKey}):?query:",
          "target": "BooksSetDetailsPage"
        }
      ],
      "targets": {
        "BooksSetMain": {
          "type": "Component",
          "id": "BooksSetMain",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "navigation": {
                "BooksSet": {
                  "detail": {
                    "route": "BooksSetDetailsPage"
                  }
                }
              },
              "contextPath": "/BooksSet",
              "viewName": "booksfpm.ext.main.Main"
            }
          }
        },
        "BooksSetDetailsPage": {
          "type": "Component",
          "id": "BooksSetDetailsPage",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/BooksSet",
              "viewName": "booksfpm.ext.view.Details"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {}
}
