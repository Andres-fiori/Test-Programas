<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:macros="sap.fe.macros"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="dialogForm"
        title="{i18n>cargadeventas}"
        class="sapUiContentPadding"
    >
        <content>
            <f:SimpleForm editable="true">
                <Label
                    text="{i18n>year}"
                    required="true"
                />

                <ComboBox
                    id="comboboxYear"
                    items="{/VH_Years}"
                    selectedKey="{
                    path: 'form>/year',
                    type: 'sap.ui.model.type.String',
                    constraints: {
                        minLength: 4
                    }}"
                >
                    <core:Item
                        key="{ID}"
                        text="{year}"
                    />
                </ComboBox>

                <Label
                    text="{i18n>month}"
                    required="true"
                />

                <ComboBox
                    id="comboboxMonth"
                    items="{/VH_Months}"
                    selectedKey="{
                    path: 'form>/month',
                    type: 'sap.ui.model.type.String',
                    constraints: {
                    minLength: 2 }}"
                >
                    <core:ListItem
                        key="{code}"
                        text="{descr}"
                        additionalText="{code}"
                    />
                </ComboBox>

                <Label
                    text="{i18n>quantity}"
                    required="true"
                />

                <Input
                    id="inputQuantity"
                    value="{
                        path: 'form>/quantity',
                        type: 'sap.ui.model.type.Integer',
                        constraints: {
                            minimum: 1 }}"
                />
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button
                id="save"
                text="{i18n>save}"
                press="onSaveSales"
                type="Accept"
                width="4rem"
            />
        </beginButton>

        <endButton>
            <Button
                id="cancel"
                text="{i18n>cancel}"
                press="onCancelSales"
                type="Reject"
                width="4rem"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
