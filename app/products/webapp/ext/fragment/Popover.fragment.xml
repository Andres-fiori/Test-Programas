<core:FragmentDefinition
    xmlns:cards="sap.f.cards"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Popover
        id="Popover"
        placement="Bottom"
        title="{i18n>selectedPoint}"
    >
        <content>
            <form:SimpleForm id="formDetails">
                <Label
                    id="labelYear"
                    text="Year"
                />
                <Text
                    id="textYear"
                    text="{/year}"
                />
                <Label
                    id="labelMonth"
                    text="Month"
                />
                <Text
                    id="textMonth"
                    text="{/month}"
                />
                <Label
                    id="labelQuantity"
                    text="QuantitySales"
                />
                <Text
                    id="textQuantity"
                    text="{/Sales}"
                />
            </form:SimpleForm>
        </content>

        <footer>
            <Toolbar id="toolbar">
                <Button
                    id="buttonClosed"
                    text="Close"
                    press="onCloseNavToDetails"
                />
                <ToolbarSpacer id="toolbarSpacer" />
                <Button
                    id="buttonNavTo"
                    text="Go Details"
                    press="onNavToDetails"
                    type="Emphasized"
                />
            </Toolbar>
        </footer>
    </Popover>
</core:FragmentDefinition>
