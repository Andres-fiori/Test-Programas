<mvc:View
    controllerName="products.ext.view.Review"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:table="sap.ui.table"
    xmlns:macros="sap.fe.macros"
>
    <Page
        id="Review"
        title="{i18n>ReviewTitle}"
    >
        <content>
            <Panel
                id="panel"
                class="sapUiResponsiveMargin"
                width="auto"
                headerText="Sales ({sales>/sum})"
            >
                <table:Table
                    id="table"
                    rows="{sales>/results}"
                >
                    <table:columns>
                        <table:Column id="column0">
                            <Label
                                id="label0"
                                text="{i18n>id}"
                            />
                            <table:template>
                                <Text
                                    id="text0"
                                    text="{sales>ID}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column id="column1">
                            <Label
                                id="label1"
                                text="{i18n>year}"
                            />
                            <table:template>
                                <Text
                                    id="text1"
                                    text="{sales>year}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column id="column2">
                            <Label
                                id="label2"
                                text="{i18n>year}"
                            />
                            <table:template>
                                <Text
                                    id="text2"
                                    text="{sales>month}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column id="column3">
                            <Label
                                id="label3"
                                text="{i18n>quantity}"
                            />
                            <table:template>
                                <Text
                                    id="text3"
                                    text="{sales>quantitySales}"
                                />
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
