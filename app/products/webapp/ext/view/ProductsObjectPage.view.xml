<mvc:View
    controllerName="products.ext.view.ProductsObjectPage"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:macros="sap.fe.macros"
>
    <uxap:ObjectPageLayout id="ObjectPageLayout">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle
                id="ObjectPageDynamicHeaderTitle"
            >
                <uxap:expandedHeading>
                    <Title
                        id="TitleExpandingHeading"
                        text="{productName}"
                    />
                </uxap:expandedHeading>

                <uxap:expandedContent>
                    <Title
                        id="TextExpandingContent"
                        text="{productName}"
                    />
                </uxap:expandedContent>

                <uxap:snappedHeading>
                    <Title
                        id="TitleSnappedHeading"
                        text="{productName}"
                    />
                </uxap:snappedHeading>

                <uxap:snappedContent>
                    <Title
                        id="TitleSnappedContent"
                        text="{productName}"
                    />
                </uxap:snappedContent>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <FlexBox
                id="headerContent"
                justifyContent="Start"
            >
                <items>
                <!--ContainerA-->
                    <VBox id="ContainerA">
                        <Title id="ImageTitle" />

                        <HBox
                            id="Image"
                            class="sapUiSmallMarginEnd"
                        >
                            <macros:Form
                                id="HeaderFacetA"
                                metaPath="/Products/@com.sap.vocabularies.UI.v1.FieldGroup#Group"
                            />
                        </HBox>
                    </VBox>
                <!--ContainerB-->
                    <VBox id="ContainerB">
                        <Title id="SupplierAndCategoryTitle" />

                        <HBox
                            id="Suppliers"
                            class="sapUiSmallMarginEnd"
                        >
                            <macros:Form
                                id="HeaderFacetB"
                                metaPath="/Products/@com.sap.vocabularies.UI.v1.FieldGroup#GroupA"
                            />
                        </HBox>
                    </VBox>
                <!--ContainerC-->
                    <VBox id="ContainerC">
                        <Title id="ProductDescriptionTitle" />

                        <HBox
                            id="ProductDescription"
                            class="sapUiSmallMarginEnd"
                        >
                            <macros:Form
                                id="HeaderFacetC"
                                metaPath="/Products/@com.sap.vocabularies.UI.v1.FieldGroup#GroupB"
                            />
                        </HBox>
                    </VBox>
                <!--ContainerD
                    <VBox id="ContainerD">
                        <Title id="SupplierAndCategoryTitle" />

                        <HBox
                            id="Suppliers"
                            class="sapUiSmallMarginEnd"
                        >
                            <macros:Form
                                id="HeaderFacetD"
                                metaPath="/Products/@com.sap.vocabularies.UI.v1.FieldGroup#GroupA"
                            />
                        </HBox>
                    </VBox>
                ContainerE
                    <VBox id="ContainerE">
                        <Title id="SupplierAndCategoryTitle" />

                        <HBox
                            id="Suppliers"
                            class="sapUiSmallMarginEnd"
                        >
                            <macros:Form
                                id="HeaderFacetE"
                                metaPath="/Products/@com.sap.vocabularies.UI.v1.FieldGroup#GroupA"
                            />
                        </HBox>
                    </VBox>-->

                </items>
            </FlexBox>
        </uxap:headerContent>
    </uxap:ObjectPageLayout>
</mvc:View>
