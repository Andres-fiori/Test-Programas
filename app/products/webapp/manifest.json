{
  "_version": "1.77.0",
  "sap.app": {
    "id": "products",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.20.4",
      "toolsId": "61ca252e-1e88-4d7d-a582-b18b3df71fd7"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/products/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.fe.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "products.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "name": "ProductsMain",
          "pattern": ":?query:",
          "target": "ProductsMain"
        },
        {
          "name": "ProductsProductsObjectPagePage",
          "pattern": "Products({ProductsKey}):?query:",
          "target": "ProductsProductsObjectPagePage"
        },
        {
          "name": "SalesReviewPage",
          "pattern": "Products(ID={key},IsActiveEntity={boolean})/toSales(year={year},month={month}):?query:",
          "target": "SalesReviewPage"
        }
      ],
      "targets": {
        "ProductsMain": {
          "type": "Component",
          "id": "ProductsMain",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "navigation": {
                "Products": {
                  "detail": {
                    "route": "ProductsProductsObjectPagePage"
                  }
                }
              },
              "contextPath": "/Products",
              "viewName": "products.ext.main.Main"
            }
          }
        },
        "ProductsProductsObjectPagePage": {
          "type": "Component",
          "id": "ProductsProductsObjectPagePage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {
                "toSales": {
                  "detail": {
                    "route": "SalesReviewPage"
                  }
                }
              },
              "contextPath": "/Products",
              "viewName": "products.ext.view.ProductsObjectPage",
              "content": {
                "body": {
                  "sections": {
                    "Sales": {
                      "template": "products.ext.fragment.Sales",
                      "position": {
                        "placement": "After",
                        "anchor": "toSales"
                      },
                      "title": "Sales"
                    }
                  }
                }
              }
            }
          }
        },
        "SalesReviewPage": {
          "type": "Component",
          "id": "SalesReviewPage",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Products/toReview",
              "viewName": "products.ext.view.Review"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "products.ext.controller.ProductObjectPage"
          }
        }
      }
    }
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
